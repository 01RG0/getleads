# =============================================================================
# VERCEL — Next.js Frontend
# =============================================================================

# App URLs
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_API_URL="https://your-backend.railway.app"

# Supabase (public keys — safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL="https://[your-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Upstash Redis (for edge/serverless caching in Next.js)
UPSTASH_REDIS_REST_URL="https://[your-redis].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# Auth
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# =============================================================================
# SUPABASE — Database
# =============================================================================
# CONNECTION POOLER (use this for all runtime queries via Prisma)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT CONNECTION (use this for Prisma migrations only)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Service Role Key (server-only — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# =============================================================================
# RAILWAY — Backend API + Workers
# Set these in Railway dashboard → Service → Variables
# =============================================================================
PORT=3001
NODE_ENV=production
CORS_ORIGIN="https://your-app.vercel.app"
API_SECRET_KEY="run: openssl rand -base64 32"

# =============================================================================
# UPSTASH REDIS — Caching + BullMQ Queue
# =============================================================================
# REST API (used by @upstash/redis in both frontend and backend)
UPSTASH_REDIS_REST_URL="https://[your-redis].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# TLS connection URL (used by BullMQ/ioredis in Railway backend)
REDIS_URL="rediss://default:[password]@[your-redis].upstash.io:6380"
